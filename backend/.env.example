# Supabase: Project Settings -> API. The service-role key is a SECRET (server only, never in the frontend).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Gmail SMTP: use a Google App Password, never your regular Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# Test-safe mail routing: every notification goes here, CC goes to the test admin.
EMAIL_TEST_MODE=true
TEST_RECIPIENT=thanosragu2005@gmail.com
TEST_CC=raghav.kartik2005@gmail.com
FRONTEND_ORIGIN=http://localhost:5173
